# Container image and required control-plane credentials.
NRE_IMAGE=sakullla/nginx-reverse-emby:latest
API_TOKEN=replace-with-a-random-32-character-panel-token
MASTER_REGISTER_TOKEN=replace-with-a-different-random-register-token

# Optional secret-vault envelope key. When empty, the control plane derives a
# stable 32-byte key from API_TOKEN. Keep the key source and key ID stable and
# never commit a real key. If encrypted secrets already exist under a derived
# key, do not set a new key by itself: use the one-time rotation inputs below.
PANEL_VAULT_MASTER_KEY=
PANEL_VAULT_KEY_ID=primary
# One-time rotation inputs. Set a new PANEL_VAULT_MASTER_KEY and a different
# PANEL_VAULT_KEY_ID, then set either the previous master key or the previous
# API token plus the key ID used by the old deployment. Remove these previous
# inputs only after startup completes the transactional migration.
PANEL_VAULT_PREVIOUS_MASTER_KEY=
PANEL_VAULT_PREVIOUS_API_TOKEN=
PANEL_VAULT_PREVIOUS_KEY_ID=

# Public panel address. Leave empty when the panel is only reached through an SSH tunnel.
NRE_PUBLIC_URL=
NRE_PANEL_PUBLIC_PATH=
# Enable only behind a proxy that removes client-supplied X-Forwarded-* headers
# and writes its own values. The bundled self-proxy does this; direct access does not.
NRE_TRUST_FORWARDED_HEADERS=false
NRE_TIMEZONE=Asia/Shanghai

# Optional internal tunnel-PKI master-key path. The value must be an absolute
# path inside the container. Mount its private parent directory read-write so a
# protected restore can atomically rotate master.key; a read-only file mount is
# unsupported. Keep the host directory 0700 and the file 0600, and never commit
# either. Leave empty to use panel/data/pki/master.key.
# Example (also uncomment the matching docker-compose.yaml directory volume):
# NRE_PKI_MASTER_KEY_FILE=/run/nre-pki/master.key
NRE_PKI_MASTER_KEY_FILE=

# DDNS public-IP probe interval for the embedded local Agent (Go duration).
NRE_DDNS_IP_PROBE_INTERVAL=5m

# Revision deadlines are captured when a revision is created.
NRE_REVISION_APPLY_TIMEOUT=1m
NRE_REVISION_DRAIN_TIMEOUT=10m

# Optional JSON object keyed by agent ID. Each field falls back to the global value.
# Keep this on one line in an env file.
NRE_REVISION_AGENT_TIMEOUT_OVERRIDES={"local":{"apply_timeout":"45s","drain_timeout":"8m"}}

# Maximum duration of one marketplace refresh, including repository fetch and
# validation (Go duration).
NRE_MARKETPLACE_REFRESH_TIMEOUT=30m

# Optional outbound proxy used by control-plane HTTP clients, including market
# repository fetches. With Docker Desktop host networking, replace PORT with
# the host loopback proxy port. Extend NO_PROXY for every local/private endpoint
# that must bypass the proxy.
# HTTP_PROXY=http://192.168.65.254:PORT
# HTTPS_PROXY=http://192.168.65.254:PORT
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# Optional DNS provider credentials. Never commit real values.
ACME_DNS_PROVIDER=
CF_TOKEN=
